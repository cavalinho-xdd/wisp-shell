#!/usr/bin/env bash
set -e

# Wisp setup script - manages installation of dependencies and dotfiles.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/wisp-shell"
BIN_DIR="${HOME}/.local/bin"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'
c_dim=$'\033[2m';  c_bold=$'\033[1m'; c_rst=$'\033[0m'
c_blu=$'\033[34m'; c_cya=$'\033[36m'

print_info() { printf "%s[INFO]%s %s\n" "${c_cya}" "${c_rst}" "$1"; }
print_succ() { printf "%s[SUCC]%s %s\n" "${c_grn}" "${c_rst}" "$1"; }
print_warn() { printf "%s[WARN]%s %s\n" "${c_yel}" "${c_rst}" "$1"; }
print_err()  { printf "%s[ERR]%s %s\n" "${c_red}" "${c_rst}" "$1"; }

dependencies=(
    "hyprland"
    "quickshell" # AUR
    "jq"
    "upower"
    "cliphist"
    "wl-clipboard"
    "grim"
    "slurp"
    "bc"
    "matugen-bin" # AUR
    "awww" # swww's actively-maintained fork; hyprpaper also works as a fallback
    "libnotify"
    "python"      # provides python3 -- core/Settings.qml shells out to
                  # scripts/apply_hypr_*.py / write_custom_keybinds.py on
                  # every Look & Feel / Keybinds change, unconditionally
    "nodejs"      # provides node -- core/Osu.qml spawns scripts/osu_connect.js
                  # unconditionally at shell startup, not gated on a setting
    "xdg-user-dirs" # provides xdg-user-dir -- core/Settings.qml's wallpaper
                    # folder default (falls back silently if missing, but
                    # ship it so the fallback is never needed)
    "curl"        # scripts/weather.sh (weather.enable defaults true) and
                  # scripts/game_watch.sh (Steam cover art / achievements)
)

ensure_aur_helper() {
    if command -v paru &>/dev/null; then echo "paru"; return; fi
    if command -v yay &>/dev/null; then echo "yay"; return; fi
    if ! command -v pacman &>/dev/null; then return; fi

    print_warn "No AUR helper (paru/yay) found. Building paru from AUR..."
    sudo pacman -S --needed --noconfirm base-devel git
    local build_dir; build_dir="$(mktemp -d)"
    if git clone --depth 1 https://aur.archlinux.org/paru-bin.git "$build_dir" >/dev/null 2>&1 \
        && (cd "$build_dir" && makepkg -si --noconfirm); then
        rm -rf "$build_dir"
        echo "paru"
    else
        rm -rf "$build_dir"
        print_warn "Failed to build paru automatically."
    fi
}

install_dependencies() {
    print_info "Checking dependencies..."

    if ! command -v pacman &>/dev/null; then
        print_warn "Not on Arch (no pacman). Skipping package installation — install manually: ${dependencies[*]}"
        return
    fi

    local missing=()
    for pkg in "${dependencies[@]}"; do
        if ! pacman -Qi "$pkg" &>/dev/null; then
            missing+=("$pkg")
        fi
    done

    if [ ${#missing[@]} -eq 0 ]; then
        print_succ "All dependencies are already installed."
        return
    fi

    print_info "Missing dependencies: ${missing[*]}"

    local helper; helper="$(ensure_aur_helper)"
    if [ -z "$helper" ]; then
        print_warn "No AUR helper available — missing packages were not installed: ${missing[*]}"
        return
    fi

    print_info "Installing via $helper..."
    "$helper" -S --needed --noconfirm "${missing[@]}" || print_warn "Some packages failed to install."
    print_succ "Dependencies installed."
}

install_wisp() {
    print_info "Installing Wisp Shell core files..."

    # 1. Install Wisp Shell core to local share
    mkdir -p "$DATA_DIR"
    cp -a "$REPO_ROOT"/* "$DATA_DIR/"

    # 2. Setup the wisp CLI wrapper
    mkdir -p "$BIN_DIR"
    ln -sf "$DATA_DIR/wisp" "$BIN_DIR/wisp"

    print_succ "Wisp core installed to $DATA_DIR"
    print_succ "CLI wrapper created at $BIN_DIR/wisp"

    ensure_path
}

# hyprland.lua's autostart line calls a bare `wisp start`. Hyprland's own exec
# environment does not inherit an interactive shell's PATH (fish's
# fish_add_path, .bashrc, etc never run for it) — only what systemd's user
# manager hands it at session start, which by default has no ~/.local/bin.
# Without this, "wisp start" silently fails to spawn and the whole shell never
# comes up, with nothing printed anywhere a user would see.
ensure_path() {
    local envd="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
    local envfile="$envd/50-wisp-bin.conf"
    mkdir -p "$envd"
    if [ ! -f "$envfile" ]; then
        printf 'PATH=%s:${PATH}\n' "$BIN_DIR" > "$envfile"
        print_succ "Added $BIN_DIR to the systemd user PATH ($envfile)."
    fi
    # Also apply to the *current* graphical session's systemd user manager,
    # so this works immediately rather than only after the next login —
    # environment.d is only read at systemd --user startup.
    if command -v systemctl &>/dev/null; then
        systemctl --user set-environment PATH="$BIN_DIR:${PATH}" 2>/dev/null || true
    fi
}

uninstall() {
    print_info "Uninstalling Wisp Shell..."
    rm -rf "$DATA_DIR"
    rm -f "$BIN_DIR/wisp"
    print_succ "Wisp Shell core and CLI removed."
    print_warn "Note: Configuration in $CONFIG_DIR/wisp and dotfiles in $CONFIG_DIR/hypr were NOT removed."
}

show_help() {
    cat <<EOF
${c_bold}Wisp Setup CLI${c_rst}

Usage: ./setup <command>

Commands:
  install       Install dependencies and the Wisp core (no dotfiles — see wisp-dots).
  update        Update the Wisp core from the repository.
  uninstall     Remove Wisp core and CLI.
  deps          Only install missing dependencies.
  help          Show this help message.

Dotfiles (Hyprland/fish/fastfetch/...) are not this script's job — install
https://github.com/cavalinho-xdd/wisp-dots instead, which pulls this repo in
as a dependency automatically.
EOF
}

command="${1:-help}"

case "$command" in
    install)
        install_dependencies
        install_wisp
        print_succ "Installation complete! $BIN_DIR was added to your PATH (new terminals and next login; already applied to this graphical session)."
        ;;
    update)
        print_info "Pulling latest changes..."
        git pull origin main || print_warn "Git pull failed, continuing with local files..."
        install_wisp
        print_succ "Update complete!"
        ;;
    uninstall)
        uninstall
        ;;
    deps)
        install_dependencies
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        print_err "Unknown command: $command"
        show_help
        exit 1
        ;;
esac
