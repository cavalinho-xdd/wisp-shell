# Runtime state — after the XDG split these live in $XDG_STATE_HOME/wisp,
# but older checkouts and dev runs still drop them here.
settings.json
colors.json
events.json
app_usage.json
generated/

# Editor / assistant scratch. .claude/ (the project skill) lives on the
# developer's machines only; the repo holds what the shell needs to run.
.claude/
.impeccable
.tokensave
*.original.md
.GEMINI.md
CLAUDE.md
plan.md
# Ignore stray markdown notes; project docs are listed explicitly.
*.md
!README.md
!PRODUCT.md
!DESIGN.md
!CHANGELOG.md
!docs/**/*.md
!.github/**/*.md

# Throwaway API probes belong in probes/ (tracked, left out of the package by
# PKGBUILD). Quick ones dropped in the repo root stay out of git.
/test*.qml
/probe*.qml
scripts/docker-test/logs/
.agents/
skills-lock.json

# Quickshell points this at its tooling VFS; machine-specific.
.qmlls.ini

# Before/after screenshots from scripts/shot.sh go into the PR, not git.
docs/screens/
