# Runtime state — after the XDG split these live in $XDG_STATE_HOME/wisp,
# but older checkouts and dev runs still drop them here.
settings.json
colors.json
events.json
app_usage.json
generated/

# Editor / assistant scratch
.impeccable
.tokensave
*.original.md
.GEMINI.md
CLAUDE.md
plan.md
# Ignore stray markdown notes; project docs are listed explicitly.
*.md
!README.md
!PRODUCT.md
!DESIGN.md
!CHANGELOG.md
!docs/**/*.md
!.github/**/*.md
!.claude/skills/**/*.md

# Throwaway API probes. These are the project's substitute for a test suite
# (see CLAUDE.md) and are useful in-tree during development, but they are not
# part of the shell and must never be installed.
test.qml
test_*.qml
scripts/docker-test/logs/
.agents/
skills-lock.json
