pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "."

// Color source of truth. Two layers:
//   1. Static Catppuccin Mocha fallback (always available).
//   2. Dynamic Material You palette from colors.json (generated by
//      scripts/apply_colors.sh via matugen), active only when
//      Settings.conf.colors.dynamicEnabled — flip the switch and every
//      bound color in the shell animates to the wallpaper palette.
// Semantic accents (green/peach/blue/yellow) stay static: M3 has no
// success/warning roles and gauges/weather need stable hue meaning.
Singleton {
    id: theme

    // Palette from colors.json; null until loaded
    property var m3: null
    property string dynWallpaper: ""
    readonly property bool dynamicActive: Settings.conf.colors.dynamicEnabled && m3 !== null

    function c(role, fallback) {
        return dynamicActive && m3[role] !== undefined ? m3[role] : fallback;
    }

    property color background: c("background", "#1e1e2e")
    property color baseSurface: c("surface_container", "#313244")
    property color surface: Qt.rgba(baseSurface.r, baseSurface.g, baseSurface.b, Settings.conf.colors.panelAlpha)
    property color primary: c("primary", "#cba6f7")
    property color colorOnPrimary: c("on_primary", "#11111b")
    // Border/separator colour. Was #45475a (Catppuccin surface1) — the same
    // value as `surface0` below, i.e. a tonal *step* doing double duty as a
    // *border*. Measured at APCA Lc 10.4 on background and 5.4 on surface,
    // against a ≥30 target for non-text UI: the shell's 44 one-pixel borders
    // were effectively invisible, adding visual noise without separating
    // anything. Raised to Catppuccin overlay1, which measures Lc 36.2/31.2 and
    // clears the target on both surfaces. See DESIGN.md finding A3.
    property color outline: c("outline_variant", "#7f849c")
    property color text: c("on_background", "#cdd6f4")
    // Secondary text. Was #a6adc8 (subtext0) at Lc 57.3/52.3/45.8 on
    // background/surface/surface0 — well under APCA's ≥75 body-text target at
    // the 10–13px sizes it is actually used at. Raised to Catppuccin subtext1.
    //
    // Honest limitation: ≥75 is NOT reachable here. Even promoting this to the
    // full `text` colour only measures 69.5 on surface0, and would erase the
    // primary/secondary distinction entirely. On a dark palette you cannot have
    // both "visibly dimmer than primary text" and Lc ≥75. The real remedy is
    // the other half of the pair — stop setting this colour at 10–11px, so the
    // ≥45 large/bold target applies instead (DESIGN.md finding A4).
    property color subtext0: c("on_surface_variant", "#bac2de")
    property color baseSurface0: c("surface_container_highest", "#45475a")
    property color surface0: Qt.rgba(baseSurface0.r, baseSurface0.g, baseSurface0.b, Settings.conf.colors.panelAlpha)
    property color red: c("error", "#f38ba8")
    property color green: "#a6e3a1"
    property color peach: "#fab387"
    property color blue: "#89b4fa"
    property color yellow: "#f9e2af"
    // Discord brand blurple — fixed, not palette-derived, on purpose: the
    // island's Discord lane is a brand badge, same reasoning as osu's pink.
    property color blurple: "#5865f2"

    // Translucent variant of background for the floating pill / settings window,
    // driven by Settings.conf.colors.panelAlpha — kept separate from `background`
    // since that property is also used as an opaque text/icon contrast color
    // all over the shell (e.g. icon glyphs on a colored fill).
    property color panelBackground: Qt.rgba(background.r, background.g, background.b, Settings.conf.colors.panelAlpha)
    Behavior on panelBackground { ColorAnimation { duration: 250; easing.type: Easing.OutCubic } }

    Behavior on background { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }
    Behavior on surface { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }
    Behavior on primary { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }
    Behavior on colorOnPrimary { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }
    Behavior on outline { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }
    Behavior on text { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }
    Behavior on subtext0 { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }
    Behavior on surface0 { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }
    Behavior on red { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }

    // ── Fonts ──
    // Picked from a preference list at startup rather than hardcoded, because
    // a missing font fails *silently and invisibly*: Qt resolves an unknown
    // family through fontconfig to whatever the default sans is, so the text
    // still renders and nothing warns. That is exactly how this project shipped
    // 75 hardcoded references to "Iosevka Nerd Font" — a font never installed
    // here — with the icons only rendering by accident, via fontconfig's
    // per-glyph fallback landing on some other Nerd Font. Resolving explicitly
    // means a missing font degrades to a *chosen* second choice, and the
    // resolution is inspectable instead of guessed.
    function pickFont(candidates, fallback) {
        const installed = Qt.fontFamilies();
        for (const c of candidates) {
            if (installed.indexOf(c) !== -1) return c;
        }
        console.warn("Theme: none of", JSON.stringify(candidates), "installed; falling back to", fallback);
        return fallback;
    }

    // Body/UI text. Google Sans Flex is a variable font (one file covers
    // tooltip-size to headline-size cleanly) and is what both of the most
    // polished reference shells (ii-dots, caelestia-dots) use as their sans.
    // Mona Sans leads: the Ember design is set in it (D2, chosen over Geist
    // as less overused). Package ttf-mona-sans.
    readonly property string fontFamily: pickFont(
        ["Mona Sans", "Google Sans Flex", "Inter", "Rubik", "Noto Sans"], "sans-serif")

    // Nerd Font glyphs. Must be a font that actually carries the Nerd glyph
    // ranges — the whole point of the resolution above.
    readonly property string fontIcon: pickFont(
        ["JetBrainsMono Nerd Font", "Symbols Nerd Font", "FantasqueSansM Nerd Font",
         "MesloLGS Nerd Font", "Iosevka Nerd Font"], "monospace")

    // Monospace (clock, numbers, keybind chips, config paths). Monaspace Neon
    // is the Ember pair to Mona Sans (D2). Package otf-monaspace.
    readonly property string fontMono: pickFont(
        ["Monaspace Neon", "JetBrainsMono Nerd Font", "JetBrains Mono", "Noto Sans Mono"], "monospace")

    Component.onCompleted: console.log("Theme fonts -> text:", fontFamily, "| icon:", fontIcon, "| mono:", fontMono)

    readonly property int animFast: 150
    readonly property int animSlow: 350

    // ── Wisp Ember tokens ──
    // Target design (DESIGN.md, references/ember-to-qml.md). Nothing reads
    // these yet; the old pill keeps using the tokens above until the islands
    // replace it. Values come from the HTML prototype and get tuned live.

    // Own neutrals: deliberately NOT palette-derived (The Own Neutrals Rule).
    // `islandText`/`islandMuted` are separate from `text`/`subtext0` because
    // those still follow matugen for the old pill.
    // `smoke` stays opaque everywhere (ink on the ember, fields, popups);
    // the island body and the layers on it come from the material below.
    readonly property color smoke: "#0a0b0e"
    readonly property color ash: mat.ash
    readonly property color ashHi: mat.ashHi
    readonly property color islandText: mat.text
    readonly property color islandMuted: mat.muted
    // A dark recess in a card (orb disc, text field); on glass it darkens the
    // blur instead of covering it.
    readonly property color well: mat.well
    // A quiet panel sitting on a card (the notification list).
    readonly property color panel: mat.panel

    // Material of the islands, set by Settings.conf.shell.material. "solid"
    // is opaque Ember and doubles as reduce transparency; the glass ones are
    // see-through fills over the compositor blur (EmberIslands'
    // BackgroundEffect), with the raised layers turning into white tints.
    // Values from docs/decisions/Wisp — směry materiálů.html (B and C).
    readonly property var materials: ({
        solid: {
            fill: "#0a0b0e", fillOpen: "#0a0b0e", tintOpen: 0,
            ash: "#15171c", ashHi: "#20232a",
            well: "#0a0b0e", panel: Qt.rgba(21 / 255, 23 / 255, 28 / 255, 0.55),
            edge: 0.06, edgeIsland: 0.06, edgeOpen: 0.06,
            text: "#eef0f4", muted: "#8a8f9b"
        },
        tinted: {
            fill: Qt.rgba(12 / 255, 13 / 255, 18 / 255, 0.72), fillOpen: Qt.rgba(10 / 255, 11 / 255, 14 / 255, 0.62), tintOpen: 0.06,
            ash: Qt.rgba(1, 1, 1, 0.06), ashHi: Qt.rgba(1, 1, 1, 0.10),
            well: Qt.rgba(0, 0, 0, 0.22), panel: Qt.rgba(0, 0, 0, 0.22),
            edge: 0.10, edgeIsland: 0.16, edgeOpen: 0.22,
            text: "#f6f7fa", muted: Qt.rgba(240 / 255, 242 / 255, 248 / 255, 0.72)
        },
        smoked: {
            fill: Qt.rgba(11 / 255, 12 / 255, 15 / 255, 0.90), fillOpen: Qt.rgba(11 / 255, 12 / 255, 15 / 255, 0.82), tintOpen: 0,
            ash: Qt.rgba(1, 1, 1, 0.045), ashHi: Qt.rgba(1, 1, 1, 0.07),
            well: Qt.rgba(0, 0, 0, 0.45), panel: Qt.rgba(0, 0, 0, 0.30),
            edge: 0.07, edgeIsland: 0.08, edgeOpen: 0.09,
            text: "#eef0f4", muted: "#a3a8b3"
        }
    })
    readonly property string material: materials[Settings.conf.shell.material] ? Settings.conf.shell.material : "solid"
    readonly property var mat: materials[material]
    readonly property bool glass: material !== "solid"
    readonly property color islandFill: mat.fill
    // The open card is lit faintly by the ember through the glass.
    readonly property color islandFillOpen: Qt.tint(mat.fillOpen, Qt.alpha(ember, mat.tintOpen))

    // The only wallpaper-derived colour.
    property color ember: c("primary", "#8fd3ff")
    Behavior on ember { ColorAnimation { duration: 600; easing.type: Easing.OutCubic } }

    // Multiplies glow alpha and blur; set by Settings.conf.shell.glow (D3).
    readonly property real glow: ({ soft: 0.6, strong: 1.6 })[Settings.conf.shell.glow] ?? 1.0
    readonly property real glowAlpha: 0.22
    readonly property real glowBlur: 22
    readonly property real glowAlphaOpen: 0.26
    readonly property real glowBlurOpen: 46
    readonly property real innerLightAlpha: 0.16
    // Glow round a lit tile well on glass.
    readonly property real wellGlowAlpha: 0.35
    readonly property real wellGlowBlur: 14

    // Depth: layers of fill (smoke, ash, ash-high), one real shadow under an
    // open card, a 1 px crescent of light on the top edge of islands, and the
    // ember lighting an active surface from inside. No edges round a shape.
    readonly property color edgeLight: Qt.rgba(1, 1, 1, mat.edge)
    readonly property color edgeLightIsland: Qt.rgba(1, 1, 1, mat.edgeIsland)
    readonly property color edgeLightOpen: Qt.rgba(1, 1, 1, mat.edgeOpen)
    readonly property real litFill: 0.06
    readonly property real litHalo: 0.30
    // The shadow of an open card: offset down, soft, black.
    readonly property color cardShadow: Qt.rgba(0, 0, 0, 0.55)
    readonly property real cardShadowBlur: 36
    readonly property int cardShadowOffset: 12

    // Geometry
    readonly property int islandHeight: 40
    readonly property int islandMargin: 12
    // Space between islands that sit side by side (cluster layout, neighbours stepping aside).
    readonly property int islandGap: 8
    readonly property int radiusIsland: 20
    readonly property int radiusIslandOpen: 30
    readonly property int radiusTile: 18
    readonly property int radiusArt: 16
    readonly property int radiusRow: 14
    readonly property int emberSize: 8
    // Longest track title shown in the collapsed activity island before it
    // elides, so the island doesn't sprawl.
    readonly property int trackMaxWidth: 120
    // Open activity island, media view.
    readonly property int mediaWidth: 440
    readonly property int artSize: 112
    readonly property int progressHeight: 4
    readonly property int controlSize: 36
    readonly property int controlSizeBig: 44
    // Performance view in the centre island: a reading above this is "hot".
    readonly property real perfHot: 0.8
    // Notification flare in the centre island.
    readonly property int flareWidth: 400
    readonly property int flareIcon: 44
    readonly property real flareGlowBoost: 1.5
    // Control centre in the right island.
    readonly property int ccWidth: 400
    // Wi-Fi / Bluetooth orb.
    readonly property int orbSize: 210
    readonly property int listRow: 44
    readonly property int listRows: 6
    // Calendar and weather view of the control centre: wider than the rest.
    readonly property int ccWideWidth: 640
    readonly property int calCell: 36
    readonly property int notifRow: 48
    readonly property int notifIcon: 30
    // Notification rows visible at once in the list; more scroll.
    readonly property int ccNotifRows: 3
    // Workspaces in the left island.
    readonly property int workspaceDot: 8
    readonly property int workspaceActiveWidth: 24
    readonly property int workspaceGap: 8
    // Launcher in the centre island.
    readonly property int launcherWidth: 520
    readonly property int launcherField: 44
    readonly property int launcherRow: 44
    readonly property int launcherIcon: 28

    readonly property int spaceXs: 6
    readonly property int spaceSm: 10
    readonly property int spaceMd: 16
    readonly property int spaceLg: 20

    // Type scale. font.pixelSize is an int, so the prototype's 13.5px body
    // rounds to 14.
    readonly property int textTitle: 17
    readonly property int textBody: 14
    readonly property int textCaption: 13
    readonly property int textLabel: 11
    readonly property int textMono: 14
    readonly property int textMonoSmall: 12

    // Motion. Curves are BezierSpline control points (end point 1,1 included).
    // Reduced motion (Settings → Shell) keeps what explains a change, a short
    // fade, and drops what only moves: overshoot, scale, shifts, blur, the
    // glow flare, breathing and hover/dim scaling.
    readonly property bool reduceMotion: Settings.conf.shell.reduceMotion
    readonly property int motionFast: 150
    // Opens by keyboard (launcher) happen often: short, no overshoot.
    readonly property int motionQuick: 200
    readonly property int motionMorph: reduceMotion ? motionFast : 620
    // Island morph is a SpringAnimation, so a click in mid-flight keeps the
    // velocity. Qt's damping is no ratio; measured on a 100 -> 400 px
    // morph: 5/0.55 settles in ~490 ms, 20/0.9 in ~200 ms (keyboard opens),
    // 30/1.0 in ~140 ms (reduced motion). None of them overshoots.
    readonly property real springMorph: reduceMotion ? 30 : 5
    readonly property real dampingMorph: reduceMotion ? 1.0 : 0.55
    readonly property real springQuick: reduceMotion ? 30 : 20
    readonly property real dampingQuick: reduceMotion ? 1.0 : 0.9
    // Islands finding their place in the bar (layout change, neighbours
    // stepping aside, drop after a drag). Measured on a 0 -> 400 px move:
    // 4/0.30 overshoots ~7 % and is within 1 px after ~540 ms; 8/0.35 was
    // too quick and twitchy (~14 %, ~370 ms).
    readonly property real springMove: reduceMotion ? 30 : 4
    readonly property real dampingMove: reduceMotion ? 1.0 : 0.30
    readonly property int motionKindle: reduceMotion ? motionFast : 550
    readonly property int kindleDelay: reduceMotion ? 0 : 100
    readonly property int kindleStagger: reduceMotion ? 0 : 50
    readonly property real kindleScale: reduceMotion ? 1 : 0.98
    readonly property int kindleShift: reduceMotion ? 0 : 5
    readonly property real kindleBlur: reduceMotion ? 0 : 0.5
    readonly property var curveKindle: [0.2, 0.8, 0.2, 1, 1, 1]
    readonly property int emberBreathe: 5000
    readonly property int emberBeat: 520
    readonly property int emberFlare: reduceMotion ? 0 : 1100

    // Islands other than the open one
    readonly property real dimOpacity: 0.35
    readonly property real dimScale: reduceMotion ? 1 : 0.96
    // Collapsed island under the pointer: hints that it opens.
    readonly property real hoverScale: reduceMotion ? 1 : 1.04
    // Collapsed island while the button is down: feedback on press, not release.
    readonly property real pressScale: reduceMotion ? 1 : 0.97

    // Volume / mic / brightness popup: an island-high pill with room around it
    // for its glow (the window is the pill plus osdGlowRoom on every side).
    readonly property int osdWidth: 240
    readonly property int osdIconSize: 20
    readonly property int osdTrackHeight: 6
    readonly property int osdReadoutWidth: 28
    readonly property real osdScale: reduceMotion ? 1 : 0.96
    readonly property int osdGlowRoom: Math.ceil(glowBlur * glow) + 8

    // Easing curve for fluid bounce
    readonly property var easeSpring: Easing.OutBack
    readonly property var easeOut: Easing.OutCubic

    FileView {
        id: colorsFile
        path: Paths.colorsFile
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            try {
                const doc = JSON.parse(text());
                theme.m3 = doc.colors;
                theme.dynWallpaper = doc.wallpaper || "";
            } catch (e) { theme.m3 = null; }
        }
        onLoadFailed: theme.m3 = null
    }
}
